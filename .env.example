# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NextAuth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# Anthropic (Claude API for URL extraction)
ANTHROPIC_API_KEY=

# RentCast (rent estimates + rental comps). Get a key at https://rentcast.io
RENTCAST_API_KEY=

# ATTOM (deed / mortgage records for the estimated outstanding loan balance)
ATTOM_API_KEY=

# Vercel Blob (large file uploads)
BLOB_READ_WRITE_TOKEN=

# Resend (outbound email; also the CRM inbound provider).
# RESEND_API_KEY is used both to send mail and to fetch inbound message bodies.
RESEND_API_KEY=
# Svix signing secret for the Resend inbound webhook (/api/webhooks/resend-inbound).
# Shown on the webhook's details page in the Resend dashboard (whsec_...).
RESEND_WEBHOOK_SECRET=

# Postmark (optional alt inbound provider — authenticates the listing + CRM BCC webhooks)
POSTMARK_WEBHOOK_SECRET=

# CRM email logging (BCC an email thread → attach to the matching contact).
# The dedicated inbound/BCC address, so it is never mistaken for a contact:
CRM_INBOUND_ADDRESS=
# Internal staff — never treated as a contact (comma-separated). The owner's
# known addresses are built in; add more here or via the settings:crm-email doc.
MONUMENT_STAFF_EMAILS=
# Optionally treat whole domains as internal (comma-separated), e.g. monumentequity.com
MONUMENT_STAFF_DOMAINS=
# Unmatched external parties become contacts automatically (default: true).
# Set to false to hold them in the review inbox for one-click adding instead.
CRM_AUTO_CREATE_CONTACTS=

# Seed Script (optional — used by scripts/seed.ts)
ADMIN_EMAIL=admin@monumentequity.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Monument Equity Admin
